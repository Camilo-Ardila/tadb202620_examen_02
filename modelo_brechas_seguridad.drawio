dFill=0;strokeWidth=1.5;" edge="1" parent="1" source="brecha_seguridad" target="organizacion"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeWidth=1.5;" edge="1" parent="1" source="brecha_seguridad" target="vector_ataque"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeWidth=1.5;" edge="1" parent="1" source="brecha_seguridad" target="severidad_incidente"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeWidth=1.5;" edge="1" parent="1" source="tipo_dato_expuesto" target="categoria_sensibilidad"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERoneToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeWidth=1.5;" edge="1" parent="1" source="brecha_usuario_tipo_dato" target="brecha_seguridad"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERoneToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeWidth=1.5;" edge="1" parent="1" source="brecha_usuario_tipo_dato" target="usuario"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeWidth=1.5;" edge="1" parent="1" source="brecha_usuario_tipo_dato" target="tipo_dato_expuesto"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="leyenda" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Azul: catálogos, Verde: entidades, Naranja: tabla puente&lt;br&gt;PK: llave primaria, FK: llave foránea (NOT NULL), UQ: única&lt;br&gt;Lado padre: exactamente uno. Lado hijo: cero o muchos (0..N), o uno o muchos (1..N) hacia la tabla puente desde brecha y usuario&lt;br&gt;Motor supuesto: PostgreSQL" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#999999;fillColor=#f5f5f5;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="340" height="130" as="geometry"/></mxCell><mxCell id="notas" value="&lt;b&gt;Restricciones adicionales&lt;/b&gt;&lt;br&gt;CHECK brecha_seguridad: fecha_deteccion_brecha &gt;= fecha_ocurrencia_brecha; registros_afectados_total_brecha &gt;= 0; costo_estimado_total_brecha &gt;= 0&lt;br&gt;CHECK organizacion: tamano_empleado_organizacion &gt; 0&lt;br&gt;Validado en carga (0 violaciones): fecha_notificacion_usuario &gt;= fecha_deteccion_brecha&lt;br&gt;Sin CHECK: fecha_registro_usuario vs fechas de brecha (hay casos posteriores)&lt;br&gt;Regla de negocio no forzada por la BD: toda brecha y todo usuario tiene al menos una fila en la tabla puente" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#999999;fillColor=#f5f5f5;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="740" width="700" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>