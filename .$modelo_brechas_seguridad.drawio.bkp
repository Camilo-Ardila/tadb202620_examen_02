nt="1" source="organizacion" target="sector_economico"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="fontSize=10;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeWidth=1.5;" edge="1" parent="1" source="organizacion" target="pais"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="fontSize=10;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeWidth=1.5;" edge="1" parent="1" source="usuario" target="pais"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="fontSize=10;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeWidth=1.5;" edge="1" parent="1" source="usuario" target="organizacion"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="fontSize=10;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeWidth=1.5;" edge="1" parent="1" source="brecha_seguridad" target="organizacion"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="fontSize=10;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeWidth=1.5;" edge="1" parent="1" source="brecha_seguridad" target="vector_ataque"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="fontSize=10;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeWidth=1.5;" edge="1" parent="1" source="brecha_seguridad" target="severidad_incidente"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="fontSize=10;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeWidth=1.5;" edge="1" parent="1" source="tipo_dato_expuesto" target="categoria_sensibilidad"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="FK compuesta (brecha, organización)" style="fontSize=10;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERoneToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeWidth=1.5;" edge="1" parent="1" source="brecha_usuario_tipo_dato" target="brecha_seguridad"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="FK compuesta (usuario, organización)" style="fontSize=10;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERoneToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeWidth=1.5;" edge="1" parent="1" source="brecha_usuario_tipo_dato" target="usuario"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="fontSize=10;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeWidth=1.5;" edge="1" parent="1" source="brecha_usuario_tipo_dato" target="tipo_dato_expuesto"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="leyenda" value="&lt;b&gt;Convención de colores y notación:&lt;/b&gt;&lt;br&gt;&lt;br&gt;Azul: catálogos, Verde: entidades, Naranja: tabla puente&lt;br&gt;&lt;br&gt;PK: llave primaria, FK: llave foránea (NOT NULL), UQ: única&lt;br&gt;&lt;br&gt;Lado padre: exactamente uno. Lado hijo: cero o muchos (0..N), o uno o muchos (1..N) hacia la tabla puente desde brecha y usuario" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#999999;fillColor=#f5f5f5;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="360" height="200" as="geometry"/></mxCell><mxCell id="notas" value="&lt;b&gt;Resumen de decisiones de diseño&lt;/b&gt;&lt;br&gt;1. Tabla puente única con PK compuesta (brecha, usuario, tipo de dato): la fecha de notificación varía según el tipo de dato (5,026 casos en la sábana), por lo que depende de la llave completa.&lt;br&gt;2. Integridad de organización: la puente guarda id_organizacion y referencia (id_brecha_seguridad, id_organizacion) y (id_usuario, id_organizacion) mediante FK compuestas. UQ1 marca esas unicidades compuestas. La BD rechaza un usuario de la organización A afectado por una brecha de la B. Es una desnormalización controlada.&lt;br&gt;3. usuario.id_organizacion se conserva: cada usuario tiene una sola organización (0 casos con más de una).&lt;br&gt;4. La multiplicidad 1..N hacia la puente es regla de negocio; la BD no puede forzar el mínimo.&lt;br&gt;5. CHECK: detección &gt;= ocurrencia; registros y costo &gt;= 0; tamaño de empleados &gt; 0. Notificación &gt;= detección se valida en la carga (0 violaciones). Sin CHECK sobre fecha_registro_usuario (hay registros posteriores a la brecha).&lt;br&gt;6. Etapa 3: último año sobre fecha_deteccion_brecha, referencia CURRENT_DATE, usuarios distintos de toda la brecha." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#999999;fillColor=#f5f5f5;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="720" width="700" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>